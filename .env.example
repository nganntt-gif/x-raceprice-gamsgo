# ===== Google Sheets =====
# ID của Google Sheets (lấy từ URL, đoạn giữa /d/ và /edit)
SPREADSHEET_ID=your_spreadsheet_id_here
# Tab cấu hình offer cần bám giá (mặc định "Setup")
SHEET_SETUP=Setup
# Tab ghi log mỗi lần sửa giá thật (mặc định "Edit History")
SHEET_EDIT_HISTORY=Edit History

# ===== Nhịp chạy (daemon — bun run start) =====
# Poll giá đối thủ mỗi N giây
POLL_INTERVAL_SECONDS=20
# Cache tab Setup: chỉ đọc lại Sheets sau N giây (tránh spam read API). Mặc định 300s (5 phút).
SETUP_CACHE_SECONDS=300

# ===== Cookies (sửa giá thật — dev-apply / daemon) =====
# File cookies export từ browser ĐÃ ĐĂNG NHẬP gamsgo.com (Playwright storageState
# hoặc extension export cookies dạng EditThisCookie/Cookie-Editor). Dùng để đọc
# cookie "token" cho POST /product/editPlanInfo — xem README mục "Sửa giá thật".
# Token TĨNH theo file này, KHÔNG tự refresh — hết hạn thì export lại file mới.
COOKIES_FILE=cookies/gamsgo_go1.json

# ===== Telegram (noti gateway) =====
# Bắn 1 tin nhắn sau mỗi lần sửa giá thật thành công (dev-apply --yes). Để trống
# cả 2 = tắt noti. QUAN TRỌNG: dùng channel/API key RIÊNG cho Gamsgo, KHÔNG dùng
# chung với bản G2G — tránh lẫn tin sửa giá 2 tool vào 1 nhóm Telegram.
NOTI_API_KEY=your_noti_api_key
NOTI_CHANNEL=your_noti_channel
